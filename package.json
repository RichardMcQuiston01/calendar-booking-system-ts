{
  "name": "@richardmcquiston01/calendar-booking-system",
  "version": "0.1.0",
  "description": "Framework-agnostic TypeScript engine for hierarchical scheduling and booking",
  "author": "Richard McQuiston <richard.mcquiston01@gmail.com>",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/calendar-booking-system-ts.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "sql/schema.sql"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint src sql",
    "build": "tsc",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bun": "latest",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
